{
  "name": "fitty",
  "version": "0.1.12",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/version.mjs check && node tests/check.mjs",
    "format": "prettier --write dist tests scripts *.md package.json .openai/hosting.json",
    "format:check": "prettier --check dist tests scripts *.md package.json .openai/hosting.json",
    "lint": "eslint dist tests scripts",
    "typecheck": "tsc --noEmit",
    "test:system": "node --test tests/browser.system.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "version:bump": "node scripts/version.mjs bump",
    "version:check": "node scripts/version.mjs check",
    "version:commits": "node scripts/version.mjs check-commits"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "eslint": "9.39.1",
    "playwright": "1.56.1"
  }
}
